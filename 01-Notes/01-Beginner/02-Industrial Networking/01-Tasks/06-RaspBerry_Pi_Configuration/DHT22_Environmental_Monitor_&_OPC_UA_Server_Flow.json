    {
        "id": "opcua_live_sensor_function",
        "type": "function",
        "z": "opcua_live_tab",
        "name": "Validate and convert live DHT22 values",
        "func": "// Expected msg.payload:\n// { temperature: 25.7, humidity: 95, timestamp: \"...\", valid: true, status: \"OK\" }\n\nconst data = msg.payload;\n\nif (!data || data.valid !== true) {\n    node.warn(\"OPC UA update skipped: sensor data is invalid or valid is not true.\");\n    return null;\n}\n\nconst temperature = Number(data.temperature);\nconst humidity = Number(data.humidity);\n\nif (!Number.isFinite(temperature) || !Number.isFinite(humidity)) {\n    node.warn(\"OPC UA update skipped: temperature or humidity is not numeric.\");\n    return null;\n}\n\n// DHT22 operating ranges: -40 to 80 °C and 0 to 100 % RH.\nif (temperature < -40 || temperature > 80 || humidity < 0 || humidity > 100) {\n    node.warn(\"OPC UA update skipped: sensor values are outside the DHT22 range.\");\n    return null;\n}\n\n// Keep metadata for the debug sidebar; the OPC UA server receives the array payload.\nmsg.sensorTimestamp = data.timestamp || null;\nmsg.sensorStatus = data.status || \"Unknown\";\nmsg.payload = [\n    {\n        messageType: \"Variable\",\n        namespace: 4,\n        variableName: \"Temperature\",\n        datatype: \"Double\",\n        variableValue: temperature\n    },\n    {\n        messageType: \"Variable\",\n        namespace: 4,\n        variableName: \"Humidity\",\n        datatype: \"Double\",\n        variableValue: humidity\n    }\n];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
