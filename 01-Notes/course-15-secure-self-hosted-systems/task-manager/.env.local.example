# Copy to .env.local for local-only development; use the SAME password as POSTGRES_PASSWORD in .env.
DATABASE_URL=postgresql://taskapp:replace-with-a-random-hex-secret@localhost:5432/taskapp
ALLOW_DEV_AUTH=true
DEV_USER_EMAIL=developer@example.test
# Not required for local development. Production must set these in the deployment environment.
ACCESS_ISSUER=
ACCESS_AUD=
